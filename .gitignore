# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/
*.tsbuildinfo

# Vault snapshot — refreshed by `npm run build-content`.
# Both the generated content.ts AND public/vault-attachments/ ARE committed so
# the repo is self-sufficient: a fresh clone (and the production build) has the
# tutorial images without needing access to the GM's G:\ Obsidian vault.
# Re-running `npm run build-content` updates them from the vault.

# Environment (only .env.example is committed)
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Obsidian (personal workspace state)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/
