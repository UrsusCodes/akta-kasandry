# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/
*.tsbuildinfo

# Vault snapshot — refreshed by `npm run build-content`.
# Generated content.ts (~100 KB) IS committed so the app boots after `git clone`.
# Attachments (typically 20-30 MB of screenshots) are NOT committed — re-run
# the generator after cloning.
public/vault-attachments/

# Environment (only .env.example is committed)
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Obsidian (personal workspace state)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/
